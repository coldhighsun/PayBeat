            <Color x:Key="SystemAccentColorLight1">#89B4FA</Color>
            <Color x:Key="SystemAccentColorLight2">#89B4FA</Color>
            <Color x:Key="SystemAccentColorLight3">#89B4FA</Color>
            <Color x:Key="SystemAccentColorDark1">#89B4FA</Color>
            <Color x:Key="SystemAccentColorDark2">#89B4FA</Color>
            <Color x:Key="SystemAccentColorDark3">#89B4FA</Color>

            <!-- Fluent control overrides so stock controls use the palette -->
