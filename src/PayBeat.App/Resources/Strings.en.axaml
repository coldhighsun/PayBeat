<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Context menu -->
    <x:String x:Key="Menu.DisplayMode">Display Mode</x:String>
    <x:String x:Key="Menu.Normal">Normal</x:String>
    <x:String x:Key="Menu.Mini">Mini</x:String>
    <x:String x:Key="Menu.None">None</x:String>
    <x:String x:Key="Menu.Flex">Flex</x:String>
    <x:String x:Key="Menu.Settings">Settings</x:String>
    <x:String x:Key="Menu.About">About</x:String>
    <x:String x:Key="Menu.Exit">Exit</x:String>

    <!-- Normal view labels -->
    <x:String x:Key="View.WorkStart">Start </x:String>
    <x:String x:Key="View.WorkEnd">End </x:String>
    <x:String x:Key="View.DailySalary">Daily</x:String>

    <!-- Flex view labels -->
    <x:String x:Key="View.Elapsed">Elapsed</x:String>
    <x:String x:Key="View.Remaining">Remaining</x:String>
    <x:String x:Key="View.WorkWindow">Work Hours</x:String>

    <!-- Settings window -->
    <x:String x:Key="Settings.WindowTitle">PayBeat Settings</x:String>
    <x:String x:Key="Settings.Title">Settings</x:String>
    <x:String x:Key="Settings.Cancel">Cancel</x:String>
    <x:String x:Key="Settings.Save">Save</x:String>

    <!-- Salary tab -->
    <x:String x:Key="Settings.Tab.Salary">Salary</x:String>
    <x:String x:Key="Settings.Section.Salary">SALARY</x:String>
    <x:String x:Key="Settings.Section.Schedule">WORK SCHEDULE</x:String>
    <x:String x:Key="Settings.Section.Refresh">REFRESH</x:String>
    <x:String x:Key="Settings.DailySalary">Daily Salary</x:String>
    <x:String x:Key="Settings.WorkHours">Work Hours</x:String>
    <x:String x:Key="Settings.RefreshInterval">Refresh Interval</x:String>
    <x:String x:Key="Settings.Seconds"> s</x:String>
    <x:String x:Key="Settings.LunchBreakEnabled">Deduct Lunch Break</x:String>
    <x:String x:Key="Settings.LunchBreakStart">Break Start</x:String>
    <x:String x:Key="Settings.LunchBreakEnd">Break End</x:String>
    <x:String x:Key="Settings.WorkOnWeekends">Earn on Weekends</x:String>

    <!-- Notifications tab -->
    <x:String x:Key="Settings.Tab.Notifications">Notifications</x:String>
    <x:String x:Key="Settings.EnableEndOfDayReminder">End-of-Day Reminder</x:String>
    <x:String x:Key="Settings.EndOfDayReminderMinutes">Minutes Before Work End</x:String>
    <x:String x:Key="Settings.EnableMilestoneNotifications">Milestone Notifications</x:String>
    <x:String x:Key="Settings.MilestoneAmount">Notify Every</x:String>

    <!-- Display tab -->
    <x:String x:Key="Settings.Tab.Display">Display</x:String>
    <x:String x:Key="Settings.DisplayMode">Display Mode</x:String>
    <x:String x:Key="Settings.Normal">Normal</x:String>
    <x:String x:Key="Settings.Mini">Mini</x:String>
    <x:String x:Key="Settings.None">None</x:String>
    <x:String x:Key="Settings.Flex">Flex</x:String>
    <x:String x:Key="Settings.Opacity">Opacity</x:String>
    <x:String x:Key="Settings.AlwaysOnTop">Always on Top</x:String>

    <!-- System tab -->
    <x:String x:Key="Settings.Tab.System">System</x:String>
    <x:String x:Key="Settings.RunAtStartup">Run at Startup</x:String>
    <x:String x:Key="Settings.Language">Language</x:String>
    <x:String x:Key="Settings.LanguageAuto">Auto</x:String>
    <x:String x:Key="Settings.Theme">Theme</x:String>
    <x:String x:Key="Settings.ThemeAuto">Auto</x:String>
    <x:String x:Key="Settings.ThemeLight">Light</x:String>
    <x:String x:Key="Settings.ThemeDark">Dark</x:String>
    <x:String x:Key="Settings.Hotkey">Toggle Visibility Hotkey</x:String>
    <x:String x:Key="Settings.HotkeyHint">Click, then press a key combination</x:String>
    <x:String x:Key="Settings.HotkeyCapturing">Press a key combination...</x:String>

    <!-- About window -->
    <x:String x:Key="About.WindowTitle">About PayBeat</x:String>
    <x:String x:Key="About.Description">A lightweight floating widget that shows your real-time earnings as the workday ticks by.</x:String>
    <x:String x:Key="About.Author">Author</x:String>
    <x:String x:Key="About.License">License</x:String>
    <x:String x:Key="About.GitHub">GitHub</x:String>
    <x:String x:Key="About.Close">Close</x:String>
    <x:String x:Key="About.Update.Checking">Checking for updates...</x:String>
    <x:String x:Key="About.Update.UpToDate">You're up to date</x:String>
    <x:String x:Key="About.Update.Available">Update available: v{0}</x:String>

    <!-- Validation errors -->
    <x:String x:Key="Error.SalaryPositive">Daily salary must be greater than 0</x:String>
    <x:String x:Key="Error.SalaryTooLarge">Daily salary cannot exceed 99,999,999</x:String>
    <x:String x:Key="Error.WorkEndAfterStart">Work start and work end cannot be the same time</x:String>
    <x:String x:Key="Error.AlreadyRunning">PayBeat is already running.</x:String>
    <x:String x:Key="Error.HotkeyConflict">Failed to register hotkey {0}. It may already be in use by another application.</x:String>
    <x:String x:Key="Error.LunchBreakInvalid">Lunch break must fall within work hours and end after it starts</x:String>
    <x:String x:Key="Error.MilestoneAmountPositive">Milestone amount must be greater than 0</x:String>
    <x:String x:Key="Error.MilestoneAmountTooLarge">Milestone amount cannot exceed the daily salary</x:String>
    <x:String x:Key="Error.EndOfDayReminderMinutesInvalid">Reminder minutes must be an integer between 1 and 60</x:String>
    <x:String x:Key="Error.SettingsSaveFailed">Failed to save settings. Check that the settings file isn't locked or read-only, then try again.</x:String>
    <x:String x:Key="Error.StartupToggleFailed">Failed to update the "Run at startup" setting. You may not have permission to change it on this machine.</x:String>

    <!-- Tray notifications -->
    <x:String x:Key="Tray.HiddenTooltip">I love work!</x:String>
    <x:String x:Key="Notification.MilestoneTitle">Earnings Milestone</x:String>
    <x:String x:Key="Notification.MilestoneBody">You've earned {0} today!</x:String>
    <x:String x:Key="Notification.EndOfDayTitle">Almost Done</x:String>
    <x:String x:Key="Notification.EndOfDayBody">Work ends in {0} minutes.</x:String>
    <x:String x:Key="Notification.UpdateAvailableTitle">Update Available</x:String>
    <x:String x:Key="Notification.UpdateAvailableBody">PayBeat v{0} is available. Open About to download it.</x:String>

</ResourceDictionary>
