<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PayBeat.App.Views.NormalView">

    <Border Background="{DynamicResource BaseBrush}"
            CornerRadius="12"
            Width="300"
            Padding="20,18"
            BorderBrush="{DynamicResource OverlayBrush}"
            BorderThickness="1">

        <StackPanel>

            <!-- Header -->
            <TextBlock Text="PayBeat"
                       Foreground="{DynamicResource SubtextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>

            <!-- Earned amount -->
            <TextBlock Text="{Binding EarnedFormatted}"
                       Foreground="{DynamicResource GreenBrush}"
                       FontSize="40"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Margin="0,6,0,0"/>

            <!-- Progress bar -->
            <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                         Minimum="0" Maximum="1"
                         Height="5"
                         Margin="0,14,0,8"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource BlueBrush}"
                         BorderThickness="0"/>

            <!-- Time range -->
            <Grid Margin="0,0,0,6" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource View.WorkStart}"
                               Foreground="{DynamicResource SubtextBrush}"
                               FontSize="11"/>
                    <TextBlock Text="{Binding WorkStart, StringFormat=HH:mm, Mode=OneWay}"
                               Foreground="{DynamicResource SubtextBrush}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource View.WorkEnd}"
                               Foreground="{DynamicResource SubtextBrush}"
                               FontSize="11"/>
                    <TextBlock Text="{Binding WorkEnd, StringFormat=HH:mm, Mode=OneWay}"
                               Foreground="{DynamicResource SubtextBrush}"
                               FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Separator -->
            <Border Height="1" Background="{DynamicResource SurfaceBrush}" Margin="0,4,0,10"/>

            <!-- Daily total -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource View.DailySalary}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Currency, Mode=OneWay}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"/>
                    <TextBlock Text="{Binding DailySalaryFormatted, Mode=OneWay}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
