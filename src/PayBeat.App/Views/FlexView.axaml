<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PayBeat.App.Views.FlexView">

    <UserControl.Styles>
        <!-- Style-applied animations pause automatically while the view is not effectively visible. -->
        <Style Selector="Border#PulseOverlay">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse#GlowEllipse">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.22"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.statLabel">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFeatures" Value="+tnum"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootGrid">
        <!-- Gradient stop colors come from the active theme and are assigned in code-behind. -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0"/>
                <GradientStop Offset="0.5"/>
                <GradientStop Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Cross-fades to a gradient whose middle stop is the surface color; this pulses the background
             because gradient stops themselves cannot be animated. -->
        <Border x:Name="PulseOverlay" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0"/>
                    <GradientStop Offset="0.5"/>
                    <GradientStop Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Glow behind the amount -->
        <Ellipse x:Name="GlowEllipse"
                 Width="900" Height="500"
                 Fill="{DynamicResource GreenBrush}"
                 Opacity="0.08">
            <Ellipse.Effect>
                <BlurEffect Radius="90"/>
            </Ellipse.Effect>
        </Ellipse>

        <Viewbox Stretch="Uniform" Margin="48">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Header -->
            <TextBlock Text="PayBeat"
                       Foreground="{DynamicResource SubtextBrush}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

            <!-- Huge earned amount; the glow effect color is assigned in code-behind. -->
            <TextBlock x:Name="AmountText"
                       Classes="numeric"
                       Text="{Binding EarnedFormatted}"
                       Foreground="{DynamicResource GreenBrush}"
                       FontSize="160"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>

            <!-- Progress bar + percentage -->
            <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                         Minimum="0" Maximum="1"
                         Width="700"
                         Height="14"
                         Margin="0,24,0,8"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource BlueBrush}"
                         BorderThickness="0"/>
            <TextBlock Text="{Binding ProgressFormatted, Mode=OneWay}"
                       Foreground="{DynamicResource SubtextBrush}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32"/>

            <!-- Stats row -->
            <Grid Width="700" ColumnDefinitions="*,*,*,*">

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource View.Elapsed}"
                               Classes="statLabel"/>
                    <TextBlock Text="{Binding ElapsedFormatted, Mode=OneWay}"
                               Classes="statValue"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource View.Remaining}"
                               Classes="statLabel"/>
                    <TextBlock Text="{Binding RemainingFormatted, Mode=OneWay}"
                               Classes="statValue"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource View.DailySalary}"
                               Classes="statLabel"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Currency, Mode=OneWay}"
                                   Classes="statValue"/>
                        <TextBlock Text="{Binding DailySalaryFormatted, Mode=OneWay}"
                                   Classes="statValue"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="{DynamicResource View.WorkWindow}"
                               Classes="statLabel"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="{Binding WorkStart, StringFormat=HH:mm, Mode=OneWay}"
                                   Classes="statValue"/>
                        <TextBlock Text="–"
                                   Classes="statValue"/>
                        <TextBlock Text="{Binding WorkEnd, StringFormat=HH:mm, Mode=OneWay}"
                                   Classes="statValue"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

        </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
