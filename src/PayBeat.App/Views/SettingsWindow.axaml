<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PayBeat.App.Views.Controls"
        x:Class="PayBeat.App.Views.SettingsWindow"
        Title="{DynamicResource Settings.WindowTitle}"
        Icon="avares://PayBeat/Resources/Icons/PayBeat.png"
        Width="400"
        Height="680"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Styles>
        <!-- Hotkey box highlighted while it is capturing a key combination -->
        <Style Selector="TextBox.capturing">
            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
        </Style>
        <Style Selector="TextBox.capturing /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CaptureBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        </Style>
    </Window.Styles>

    <Border x:Name="RootBorder"
            Focusable="True"
            Background="{DynamicResource BaseBrush}"
            CornerRadius="{DynamicResource RadiusLg}"
            BorderBrush="{DynamicResource OverlayBrush}"
            BorderThickness="1">

        <DockPanel Margin="28,20" LastChildFill="True">

            <!-- Title bar: title plus close button (same as Cancel) -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Settings.Title}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button x:Name="TitleCloseButton"
                        Grid.Column="1"
                        Classes="icon"
                        Content="✕"
                        Margin="0,0,-8,0"
                        Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="{DynamicResource Settings.Cancel}"
                        Command="{Binding CancelCommand}"
                        Classes="secondary"
                        IsCancel="True"
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Settings.Save}"
                        Command="{Binding SaveCommand}"
                        Classes="primary"
                        IsDefault="True"/>
            </StackPanel>

            <!-- Error -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource RedBrush}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Padding="10,8"
                    Margin="0,12,0,0"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource RedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Tab control -->
            <TabControl x:Name="SettingsTabs" Classes="settings">

                <!-- ── Salary ── -->
                <TabItem Header="{DynamicResource Settings.Tab.Salary}" Classes="settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Settings.Section.Salary}" Classes="sectionHeader"/>
                            <Border Classes="group">
                                <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.DailySalary}" Classes="fieldLabel"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox Width="52" Text="{Binding CurrencyText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox x:Name="SalaryBox" Width="120" Text="{Binding DailySalaryText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" MaxLength="11"/>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource Settings.Section.Schedule}" Classes="sectionHeader"/>
                            <Border Classes="group">
                                <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.WorkHours}" Classes="fieldLabel"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:TimePickerControl SelectedTime="{Binding WorkStart}"/>
                                        <TextBlock Text="–" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="6,0"/>
                                        <controls:TimePickerControl SelectedTime="{Binding WorkEnd}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Classes="divider"/>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <CheckBox Grid.Column="0" Content="{DynamicResource Settings.LunchBreakEnabled}" IsChecked="{Binding LunchBreakEnabled}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding LunchBreakEnabled}">
                                        <controls:TimePickerControl SelectedTime="{Binding LunchBreakStart}"/>
                                        <TextBlock Text="–" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="6,0"/>
                                        <controls:TimePickerControl SelectedTime="{Binding LunchBreakEnd}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Classes="divider"/>
                                <Grid Classes="row" ColumnDefinitions="*">
                                    <CheckBox Content="{DynamicResource Settings.WorkOnWeekends}" IsChecked="{Binding WorkOnWeekends}" VerticalAlignment="Center"/>
                                </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource Settings.Section.Refresh}" Classes="sectionHeader"/>
                            <Border Classes="group">
                                <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.RefreshInterval}" Classes="fieldLabel"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RefreshInterval}" Classes="readout"/>
                                        <TextBlock Text="{DynamicResource Settings.Seconds}" Classes="readout"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="1" Maximum="60" Value="{Binding RefreshInterval}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Notifications ── -->
                <TabItem Header="{DynamicResource Settings.Tab.Notifications}" Classes="settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Settings.Section.Reminders}" Classes="sectionHeader"/>
                            <Border Classes="group">
                                <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="*">
                                    <CheckBox Content="{DynamicResource Settings.EnableEndOfDayReminder}" IsChecked="{Binding EnableEndOfDayReminder}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="28,0,0,0" IsEnabled="{Binding EnableEndOfDayReminder}">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.EndOfDayReminderMinutes}" Classes="fieldLabel"/>
                                    <TextBox x:Name="EndOfDayMinutesBox" Grid.Column="1" Width="72" Text="{Binding EndOfDayReminderMinutesText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" MaxLength="2"/>
                                </Grid>
                                <Border Classes="divider"/>
                                <Grid Classes="row" ColumnDefinitions="*">
                                    <CheckBox Content="{DynamicResource Settings.EnableMilestoneNotifications}" IsChecked="{Binding EnableMilestoneNotifications}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="28,0,0,0" IsEnabled="{Binding EnableMilestoneNotifications}">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.MilestoneAmount}" Classes="fieldLabel"/>
                                    <TextBox x:Name="MilestoneBox" Grid.Column="1" Width="120" Text="{Binding MilestoneAmountText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" MaxLength="11"/>
                                </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Display ── -->
                <TabItem Header="{DynamicResource Settings.Tab.Display}" Classes="settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Settings.Section.Widget}" Classes="sectionHeader"/>
                            <Border Classes="group">
                                <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.DisplayMode}" Classes="fieldLabel" Margin="0,12,0,8"/>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton Content="{DynamicResource Settings.Flex}"
                                                 GroupName="DisplayMode"
                                                 IsChecked="{Binding IsFlexMode}"
                                                 Margin="0,0,16,0"
                                                 ToolTip.ShowDelay="200">
                                        <ToolTip.Tip>
                                            <Image Source="avares://PayBeat/Resources/Screenshots/flex.png" Width="600" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        </ToolTip.Tip>
                                    </RadioButton>
                                    <RadioButton Content="{DynamicResource Settings.Normal}"
                                                 GroupName="DisplayMode"
                                                 IsChecked="{Binding IsNormalMode}"
                                                 Margin="0,0,16,0"
                                                 ToolTip.ShowDelay="200">
                                        <ToolTip.Tip>
                                            <Image x:Name="NormalPreview" Source="avares://PayBeat/Resources/Screenshots/normal.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        </ToolTip.Tip>
                                    </RadioButton>
                                    <RadioButton Content="{DynamicResource Settings.Mini}"
                                                 GroupName="DisplayMode"
                                                 IsChecked="{Binding IsMiniMode}"
                                                 Margin="0,0,16,0"
                                                 ToolTip.ShowDelay="200">
                                        <ToolTip.Tip>
                                            <Image x:Name="MiniPreview" Source="avares://PayBeat/Resources/Screenshots/mini.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        </ToolTip.Tip>
                                    </RadioButton>
                                    <RadioButton Content="{DynamicResource Settings.None}"
                                                 GroupName="DisplayMode"
                                                 IsChecked="{Binding IsNoneMode}"/>
                                                            </WrapPanel>
                                <Border Classes="divider"/>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Opacity}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OpacityFormatted}" Classes="readout"/>
                                </Grid>
                                <Slider Minimum="0.1" Maximum="1.0" Value="{Binding Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                                <Border Classes="divider"/>
                                <Grid Classes="row" ColumnDefinitions="*">
                                    <CheckBox Content="{DynamicResource Settings.AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Classes="divider"/>
                                <Grid Classes="row" ColumnDefinitions="*">
                                    <CheckBox Content="{DynamicResource Settings.AutoHideAtEdge}" IsChecked="{Binding AutoHideAtEdge}" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Classes="divider"/>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Theme}" Classes="fieldLabel"/>
                                    <ComboBox Grid.Column="1" Width="160"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedValue="{Binding Theme}"
                                              SelectedValueBinding="{Binding Code}"
                                              HorizontalContentAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── System ── -->
                <TabItem Header="{DynamicResource Settings.Tab.System}" Classes="settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Settings.Section.General}" Classes="sectionHeader"/>
                            <Border Classes="group">
                                <StackPanel>
                                <StackPanel IsVisible="{Binding IsStartupSupported}">
                                    <Grid Classes="row" ColumnDefinitions="*">
                                        <CheckBox Content="{DynamicResource Settings.RunAtStartup}" IsChecked="{Binding RunAtStartup}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsHotkeySupported}">
                                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Hotkey}" Classes="fieldLabel"/>
                                        <TextBox x:Name="HotkeyBox" Grid.Column="1" Width="160" Text="{Binding HotkeyDisplayText, Mode=OneWay}" IsReadOnly="True" Cursor="IBeam"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Settings.HotkeyHint}" Classes="rowHint"/>
                                    <Border Classes="divider"/>
                                </StackPanel>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Language}" Classes="fieldLabel"/>
                                    <ComboBox Grid.Column="1" Width="160"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              SelectedValue="{Binding Language}"
                                              SelectedValueBinding="{Binding Code}"
                                              HorizontalContentAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
