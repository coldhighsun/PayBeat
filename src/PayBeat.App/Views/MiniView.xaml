<UserControl x:Class="PayBeat.App.Views.MiniView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="MiniAmountText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BaseBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource OverlayBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="16" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="12,7,12,6">
                <!-- Invisible but measured: reserves the width of the maximum (full daily salary) amount. -->
                <TextBlock Text="{Binding MiniWidthTemplate}"
                           Style="{StaticResource MiniAmountText}"
                           Visibility="Hidden"/>
                <TextBlock Text="{Binding EarnedFormatted}"
                           Style="{StaticResource MiniAmountText}"
                           Foreground="{DynamicResource GreenBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                         Minimum="0"
                         Maximum="1"
                         Height="3"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource BlueBrush}"
                         BorderThickness="0"/>
        </StackPanel>
    </Border>
</UserControl>
