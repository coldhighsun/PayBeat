<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Resources\Icons\PayBeat.ico</ApplicationIcon>
    <AssemblyName>PayBeat</AssemblyName>
    <RootNamespace>PayBeat.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- The release workflow sets this. Only official builds look for updates by themselves: the version of any other
         build, such as one from a commit after the last tag, is below every release. -->
    <OfficialBuild Condition="'$(OfficialBuild)' == ''">false</OfficialBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OfficialBuild</_Parameter1>
      <_Parameter2>$(OfficialBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\Icons\PayBeat.ico" />
    <AvaloniaResource Include="Resources\Icons\PayBeat.png" />
    <AvaloniaResource Include="Resources\Screenshots\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="GitHubReleaseUpdater" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PayBeat.App.Tests" />
  </ItemGroup>

  <!-- The native SkiaSharp/HarfBuzz packages ship ~100 MB of .pdb files; they are not needed at runtime. -->
  <Target Name="RemoveNativePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
